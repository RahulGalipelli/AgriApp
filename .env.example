# AgriApp (frontend) - Local development
# Copy this file to .env and set your machine's IP (optional).
# Get your IP: Windows: ipconfig  |  Mac/Linux: ifconfig
# Frontend and backend must be on the same network as your phone/emulator.

# Local backend URL (uncomment and set when you want to override config.ts)
# EXPO_PUBLIC_API_URL=http://YOUR_IP_HERE:8003

# Example (replace with your PC's IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8003
